# The workload CA, declared: component `infra/cert-manager-issuers`.
#
#   ClusterIssuer `selfsigned`   signs the root below, nothing else
#   Certificate   `cluster-ca`   the root CA (namespace cert-manager, Secret
#                                `cluster-ca`): isCA, ECDSA P-384, 10 years,
#                                renewed a year before expiry with the SAME
#                                key (rotationPolicy Never), so leaves and
#                                trust stores keep verifying across renewals
#   ClusterIssuer `cluster-ca`   CA issuer over that Secret: what workloads
#                                reference
#
# The root key is generated by cert-manager in the cluster and stays in that
# Secret; nobody copies it, and it is unrelated to the bootstrap CAs
# (cluster-pki on r440, docs/pki.md). Deleting the Certificate (or this
# component) leaves the Secret in place (no owner reference), so re-adding
# it reuses the same CA.
#
# Applied by its own Flux Kustomization `cert-manager-issuers`
# (components/flux/stages.nix), after `flux-system` has applied the same
# revision. cert-manager's webhook validates every cert-manager.io object
# with failurePolicy Fail, server-side dry runs included: in `flux-system`
# these objects would make the whole cluster's apply fail whenever the
# webhook is down, the fix for the webhook included. Here only this
# Kustomization fails, and retries.
#
# Only the chart's CRDs are read here (to type the objects below); the chart
# itself is rendered by chart.nix.
{
  pkgs,
  catenix,
  charts,
  cluster,
  kubeVersion,
  ...
}:
let
  inherit (import ./settings.nix)
    namespace
    release
    caIssuer
    caSecret
    selfSignedIssuer
    ;

  crds = builtins.filter (m: m.kind or null == "CustomResourceDefinition") (
    builtins.fromJSON (
      builtins.readFile (
        catenix.helmTemplate pkgs {
          inherit kubeVersion release;
          chart = charts.cert-manager;
          values.crds.enabled = true;
        }
      )
    )
  );
in
{
  imports = [ (catenix.crdModule crds) ];

  validation.strict = true;

  resources."cert-manager.io".v1 = {
    ClusterIssuer.${selfSignedIssuer}.spec.selfSigned = { };

    Certificate.${caSecret} = {
      metadata = { inherit namespace; };
      spec = {
        isCA = true;
        commonName = "${cluster.name} workload CA";
        subject = {
          organizations = [ cluster.name ];
          organizationalUnits = [ "cert-manager" ];
        };
        secretName = caSecret;
        duration = "87600h"; # 10 years
        renewBefore = "8760h"; # 1 year
        privateKey = {
          algorithm = "ECDSA";
          size = 384;
          rotationPolicy = "Never";
        };
        usages = [
          "cert sign"
          "crl sign"
          "digital signature"
        ];
        revisionHistoryLimit = 1;
        issuerRef = {
          group = "cert-manager.io";
          kind = "ClusterIssuer";
          name = selfSignedIssuer;
        };
      };
    };

    ClusterIssuer.${caIssuer}.spec.ca.secretName = caSecret;
  };
}
