# Open WebUI (chat front-end for c4130's vLLM), namespace `open-webui`.
# Moved from a NixOS service on c4130 (hosts/c4130/vllm/open-webui.nix,
# same version, 0.12.2, so the database schema matches) on 2026-11-10.
#
#   https://chat.neuros.is (cluster.openWebui.host) -> cloudflared + nginx
#     (components/cloudflared.nix) -> Service open-webui at the fixed
#     ClusterIP cluster.openWebui.serviceIP -> pod :8080
#   models: vLLM's OpenAI-compatible API on c4130 (LAN, port 8000), so the
#     served model follows services.vllm-sm70.activeModel as before.
#
# One replica (SQLite; strategy Recreate), data on r440 (hostPath PV
# /var/lib/open-webui/data, Retain): amd64 (the image's torch & co. are not
# tried on m2mini's 16 KiB pages) and off c4130, whose RAM vLLM + LMCache
# need. r440's disk is slow but Open WebUI's writes are small.
#
# Login: the local login form as before, plus "Continue with authentik" =
# OIDC against authentik's confidential provider `open-webui` (blueprint in
# components/authentik.nix), which only members of the authentik group
# `local-ai` may use. New SSO users are created (ENABLE_OAUTH_SIGNUP) with
# the instance's default role, which is "pending" unless an admin changed
# it, and an existing account with the same e-mail is linked
# (OAUTH_MERGE_ACCOUNTS_BY_EMAIL). Roles are not taken from authentik, so
# no login can demote or promote an existing admin. OAuth settings come
# from the environment, never the database (ENABLE_OAUTH_PERSISTENT_CONFIG
# is off by default).
#
# Secrets are NOT in git: Secret open-webui/open-webui-secrets (by hand),
#   WEBUI_SECRET_KEY     signs sessions; carried over from c4130's
#                        .webui_secret_key so logged-in users stay logged in
#   OAUTH_CLIENT_SECRET  the `open-webui` provider's client secret
#                        (generated by authentik)
# See k8s/README.md, "Open WebUI".
{ lib, cluster, k8sLib, ... }:
let
  namespace = "open-webui";
  name = "open-webui";
  labels."app.kubernetes.io/name" = "open-webui";
  secretName = "open-webui-secrets";

  # Single instance (SQLite). Data migrated from c4130 on 2026-11-10.
  replicas = 1;

  port = 8080;
  vllmUrl = "http://${cluster.nodes.c4130.lanIP}:8000/v1";
  issuer = "https://${cluster.authentik.host}/application/o/open-webui/";

  env = {
    SCARF_NO_ANALYTICS = "True";
    DO_NOT_TRACK = "True";
    ANONYMIZED_TELEMETRY = "False";
    ENABLE_VERSION_UPDATE_CHECK = "False";

    WEBUI_URL = "https://${cluster.openWebui.host}";
    WEBUI_AUTH = "True";

    ENABLE_OLLAMA_API = "False";
    ENABLE_OPENAI_API = "True";
    OPENAI_API_BASE_URL = vllmUrl;
    OPENAI_API_KEY = "none";

    # As on c4130: no local embedding/RAG models, nothing downloaded.
    OFFLINE_MODE = "True";
    HF_HUB_OFFLINE = "1";
    BYPASS_EMBEDDING_AND_RETRIEVAL = "True";
    RAG_EMBEDDING_ENGINE = "openai";
    RAG_EMBEDDING_MODEL_AUTO_UPDATE = "False";
    RAG_RERANKING_MODEL_AUTO_UPDATE = "False";
    WHISPER_MODEL_AUTO_UPDATE = "False";

    # OIDC (authentik, group local-ai). The client secret is in the Secret.
    ENABLE_OAUTH_SIGNUP = "True";
    OAUTH_MERGE_ACCOUNTS_BY_EMAIL = "True";
    OAUTH_PROVIDER_NAME = "authentik";
    OAUTH_CLIENT_ID = "open-webui";
    OPENID_PROVIDER_URL = "${issuer}.well-known/openid-configuration";
    OPENID_REDIRECT_URI = "https://${cluster.openWebui.host}/oauth/oidc/callback";
    OAUTH_SCOPES = "openid email profile";
    OAUTH_CODE_CHALLENGE_METHOD = "S256";
  };
in
{
  imports = [
    (k8sLib.localVolume {
      inherit namespace name;
      node = "r440";
      path = "/var/lib/open-webui/data";
      size = "10Gi";
    })
  ];

  validation.strict = true;

  # baseline: the image runs as root.
  resources.core.v1.Namespace.${namespace}.metadata.labels = {
    "pod-security.kubernetes.io/enforce" = "baseline";
    "pod-security.kubernetes.io/warn" = "restricted";
  };

  resources.apps.v1.Deployment.${name} = {
    metadata = { inherit namespace labels; };
    spec = {
      inherit replicas;
      selector.matchLabels = labels;
      strategy.type = "Recreate";
      template = {
        metadata.labels = labels;
        spec = {
          securityContext.seccompProfile.type = "RuntimeDefault";
          containers = [
            {
              inherit name;
              image = "ghcr.io/open-webui/open-webui:v0.12.2";
              env =
                lib.mapAttrsToList (n: v: {
                  name = n;
                  value = v;
                }) env
                ++
                  map
                    (key: {
                      name = key;
                      valueFrom.secretKeyRef = {
                        name = secretName;
                        inherit key;
                      };
                    })
                    [
                      "WEBUI_SECRET_KEY"
                      "OAUTH_CLIENT_SECRET"
                    ];
              ports = [
                {
                  name = "http";
                  containerPort = port;
                }
              ];
              startupProbe = {
                httpGet = {
                  path = "/health";
                  port = "http";
                };
                periodSeconds = 10;
                failureThreshold = 60;
              };
              readinessProbe = {
                httpGet = {
                  path = "/health";
                  port = "http";
                };
                periodSeconds = 10;
              };
              livenessProbe = {
                httpGet = {
                  path = "/health";
                  port = "http";
                };
                periodSeconds = 30;
                failureThreshold = 5;
              };
              securityContext = {
                allowPrivilegeEscalation = false;
                capabilities.drop = [ "ALL" ];
              };
              resources = {
                requests = {
                  cpu = "250m";
                  memory = "1Gi";
                };
                limits.memory = "4Gi";
              };
              volumeMounts = [
                {
                  name = "data";
                  mountPath = "/app/backend/data";
                }
              ];
            }
          ];
          volumes = [
            {
              name = "data";
              persistentVolumeClaim.claimName = name;
            }
          ];
        };
      };
    };
  };

  resources.core.v1.Service.${name} = {
    metadata = { inherit namespace labels; };
    spec = {
      clusterIP = cluster.openWebui.serviceIP;
      selector = labels;
      ports = [
        {
          name = "http";
          port = 80;
          targetPort = "http";
        }
      ];
    };
  };
}
